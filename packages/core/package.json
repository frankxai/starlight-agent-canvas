{
  "name": "@starlight-agent-canvas/core",
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./atlas-context": {
      "types": "./dist/atlas-context.d.ts",
      "import": "./dist/atlas-context.js"
    },
    "./website": {
