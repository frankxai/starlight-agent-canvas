# Optional. Defaults to <home>/.starlight/agent-canvas.
AGENT_CANVAS_HOME=

# Optional. Keep unset unless intentionally exposing the API beyond localhost.
AGENT_CANVAS_ALLOW_REMOTE=

# Optional. Used only when a URL-ingest request explicitly opts into Firecrawl.
FIRECRAWL_API_KEY=

# Optional provider keys. Existing keyless actions remain deterministic and local.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=

# Website generation is disabled by default and requires a local workspace.
# Explicitly choose openai or anthropic and a model supporting structured output.
# Provider API billing is separate from CLI subscriptions; no default model is selected.
AGENT_CANVAS_WEBSITE_GENERATION=0
AGENT_CANVAS_WEBSITE_PROVIDER=
AGENT_CANVAS_WEBSITE_MODEL=
